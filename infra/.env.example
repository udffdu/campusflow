# Copy to infra/.env; replace every placeholder before starting. Never commit .env.
DATABASE_PASSWORD=replace-with-a-long-random-database-password
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Local HTTP only. Production HTTPS must use true.
COOKIE_SECURE=false
# Independent random secrets of at least 32 characters; blank disables the caller.
M1_SERVICE_KEY=
M2_SERVICE_KEY=
M3_SERVICE_KEY=

# M2 owns an independent database; do not reuse D credentials.
ROOMS_DATABASE_PASSWORD=replace-with-a-separate-long-random-password
# M1 must implement contracts/m2-occupancy-api.md before real approvals can complete.
M1_URL=http://seats:8081
M2_OCCUPANCY_KEY=
